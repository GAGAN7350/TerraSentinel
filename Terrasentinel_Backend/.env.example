# ============================================================
# TerraSentinel Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

APP_NAME=TerraSentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# CORS — JSON array of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# PostgreSQL / PostGIS (used if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=terrasentinel
POSTGRES_PASSWORD=change-me
POSTGRES_DB=terrasentinel

# OR set a full DSN (takes priority over split vars above)
# DATABASE_URL=postgresql://terrasentinel:change-me@localhost:5432/terrasentinel

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Redis (placeholder — not used in Phase 1/2)
REDIS_URL=redis://localhost:6379/0
