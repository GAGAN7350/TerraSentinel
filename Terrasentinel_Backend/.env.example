# ============================================================
# TerraSentinel Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Application
APP_NAME=TerraSentinel
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# API
API_V1_PREFIX=/api/v1

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL / PostGIS
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=terrasentinel
POSTGRES_PASSWORD=terrasentinel_dev
POSTGRES_DB=terrasentinel

# Redis (not used yet — placeholder)
REDIS_URL=redis://localhost:6379/0

# Security (replace in production)
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
